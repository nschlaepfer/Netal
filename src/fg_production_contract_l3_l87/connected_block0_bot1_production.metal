inline half connected_b0_bot1_up(device const half*in,int x,int y,uint c){if(x<0||x>=320||y<0||y>=184)return half(0);float fx=(float(x)-0.5f)*0.5f,fy=(float(y)-0.5f)*0.5f;uint x0=fx<0?0u:min(uint(fx),159u),x1=fx<0?0u:min(uint(fx+1.0f),159u),y0=fy<0?0u:min(uint(fy),91u),y1=fy<0?0u:min(uint(fy+1.0f),91u);half wx1=half(fx-float(x0)),wx0=half((float(x0)-fx)+1.0f),wy1=half(fy-float(y0)),wy0=half((float(y0)-fy)+1.0f);half a=in[(y0*160u+x0)*32u+c],b=in[(y0*160u+x1)*32u+c],d=in[(y1*160u+x0)*32u+c],e=in[(y1*160u+x1)*32u+c];half rb=wx1*b;half top=fma(wx0,a,rb);half re=wx1*e;half bot=fma(wx0,d,re);half lower=wy1*bot;return fma(wy0,top,lower);}
inline uint connected_b0_bot1_wi(uint t,uint s,uint ic,uint oc){uint k=ic%16u,lane=oc*4u+(k%8u)/2u,f=(k>=8u?2u:0u)+(k&1u);return t*256u+s*128u+(f>=2u?64u:0u)+lane*2u+(f&1u);}
kernel void fg_connected_block0_bot1(device const half*w[[buffer(0)]],device const half*b[[buffer(1)]],device const half*i0[[buffer(2)]],device const half*i1[[buffer(3)]],device const half*i2[[buffer(4)]],device half*o0[[buffer(5)]],device half*o1[[buffer(6)]],device half*o2[[buffer(7)]],uint3 p[[thread_position_in_grid]]){if(p.x>=320||p.y>=184||p.z>=8)return;uint oc=p.z;device const half*in=oc<4?i0:(oc==4?i1:i2);half a=b[oc];for(uint t=0;t<9;++t){int x=int(p.x)+int(t%3u)-1,y=int(p.y)+int(t/3u)-1;for(uint s=0;s<2;++s){ushort av[16],bv[16];for(uint k=0;k<16;++k){uint ic=s*16u+k;av[k]=as_type<ushort>(connected_b0_bot1_up(in,x,y,ic));bv[k]=as_type<ushort>(w[connected_b0_bot1_wi(t,s,ic,oc)]);}a=fg_hmma_f16_bits_16(av,bv,a);if(as_type<ushort>(a)==0x8000u)a=as_type<half>(ushort(0u));}}if(oc>=4)a=min(max(a,half(-6.0f)),half(6.0f));if(oc<4)o0[(p.y*320u+p.x)*4u+oc]=a;else if(oc==4)o1[p.y*320u+p.x]=a;else o2[(p.y*320u+p.x)*3u+oc-5u]=a;}
