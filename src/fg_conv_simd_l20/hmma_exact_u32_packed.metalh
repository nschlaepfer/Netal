#pragma once

#include "hmma_exact_u32.metalh"

// Exact u32 accumulation with one packed scratch word per product. A finite
// half product significand needs at most 25 bits; its exponent sum spans
// [-28, 30] and needs six biased bits; the final bit stores the sign.
inline half fg_hmma_f16_bits_16_u32_packed(
    thread const ushort* a_values, thread const ushort* b_values, half prior) {
  uint products[16];
  int maximum_exponent = -21;
  for (uint inner = 0u; inner < 16u; ++inner) {
    const ushort a_bits = a_values[inner];
    const ushort b_bits = b_values[inner];
    const uint a_field = (uint(a_bits) >> 10u) & 31u;
    const uint b_field = (uint(b_bits) >> 10u) & 31u;
    uint a_mantissa = uint(a_bits) & 1023u;
    uint b_mantissa = uint(b_bits) & 1023u;
    if (a_field != 0u) a_mantissa += 1024u;
    if (b_field != 0u) b_mantissa += 1024u;
    const uint significand = a_mantissa * b_mantissa * 8u;
    const int exponent =
        (a_field == 0u ? -14 : int(a_field) - 15) +
        (b_field == 0u ? -14 : int(b_field) - 15);
    const uint negative = ((a_bits ^ b_bits) >> 15u) & 1u;
    products[inner] = significand | (uint(exponent + 28) << 25u) |
                      (negative << 31u);
    if (significand != 0u)
      maximum_exponent = max(maximum_exponent, exponent);
  }

  const ushort c_bits = as_type<ushort>(prior);
  const uint c_field = (uint(c_bits) >> 10u) & 31u;
  const uint c_fraction = uint(c_bits) & 1023u;
  uint c_significand = 0u;
  int c_exponent = -1024;
  if (c_field != 0u) {
    c_significand = (1024u + c_fraction) << 13u;
    c_exponent = int(c_field) - 15;
  } else if (c_fraction != 0u) {
    const uint leading = 31u - clz(c_fraction);
    c_significand = c_fraction << (23u - leading);
    c_exponent = int(leading) - 24;
  }
  if (c_significand != 0u)
    maximum_exponent = max(maximum_exponent, c_exponent);

  uint positive = 0u;
  uint negative = 0u;
  for (uint inner = 0u; inner < 16u; ++inner) {
    const uint product = products[inner];
    const uint significand = product & 0x01ffffffu;
    const int exponent = int((product >> 25u) & 0x3fu) - 28;
    const int shift = maximum_exponent - exponent;
    const uint aligned = shift > 31
        ? 0u : (significand << 2u) >> uint(shift);
    if ((product & 0x80000000u) != 0u) negative += aligned;
    else positive += aligned;
  }
  if (c_significand != 0u) {
    const int shift = maximum_exponent - c_exponent;
    const uint aligned = shift > 31
        ? 0u : (c_significand << 2u) >> uint(shift);
    if ((c_bits & 0x8000u) != 0u) negative += aligned;
    else positive += aligned;
  }
  const bool result_negative = negative > positive;
  const uint magnitude = result_negative ? negative - positive
                                         : positive - negative;
  return fg_fixed_u32_to_half_rne(
      magnitude, result_negative, maximum_exponent - 25);
}
