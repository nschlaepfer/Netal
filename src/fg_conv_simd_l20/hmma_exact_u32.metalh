#pragma once
#include <metal_stdlib>

using namespace metal;

inline uint fg_round_shift_rne_u32(uint value, uint shift) {
  if (shift == 0u) return value;
  if (shift >= 32u) return 0u;
  const uint quotient = value >> shift;
  const uint remainder = value & ((1u << shift) - 1u);
  const uint halfway = 1u << (shift - 1u);
  return quotient +
         uint(remainder > halfway ||
              (remainder == halfway && (quotient & 1u) != 0u));
}

inline half fg_fixed_u32_to_half_rne(uint magnitude, bool negative,
                                     int scale) {
  if (magnitude == 0u) return as_type<half>(ushort(0u));
  const uint leading = 31u - clz(magnitude);
  int exponent = int(leading) + scale;
  uint significand = 0u;
  uint result = 0u;
  if (exponent >= -14) {
    const int shift = int(leading) - 10;
    significand = shift > 0
        ? fg_round_shift_rne_u32(magnitude, uint(shift))
        : magnitude << uint(-shift);
    if (significand >= 2048u) {
      significand >>= 1u;
      ++exponent;
    }
    result = exponent > 15
        ? 0x7c00u
        : (uint(exponent + 15) << 10u) | (significand - 1024u);
  } else {
    const int shift = -(scale + 24);
    significand = shift > 0
        ? fg_round_shift_rne_u32(magnitude, uint(shift))
        : magnitude << uint(-shift);
    result = significand >= 1024u ? 0x0400u : significand;
  }
  if (negative) result |= 0x8000u;
  return as_type<half>(ushort(result));
}

// Exact scalar numerical contract of one Blackwell HMMA.16816.F16 output.
// Each aligned term is below 2^27. Sixteen products plus the prior half are
// below 2,212,463,104, so independent positive and negative totals fit uint32
// without changing the accepted signed sum.
inline half fg_hmma_f16_bits_16_u32(thread const ushort* a_values,
                                    thread const ushort* b_values,
                                    half prior) {
  uint product_significands[16];
  int product_exponents[16];
  bool product_negative[16];
  int maximum_exponent = -21;
  for (uint inner = 0u; inner < 16u; ++inner) {
    const ushort a_bits = a_values[inner];
    const ushort b_bits = b_values[inner];
    const uint a_field = (uint(a_bits) >> 10u) & 31u;
    const uint b_field = (uint(b_bits) >> 10u) & 31u;
    uint a_mantissa = uint(a_bits) & 1023u;
    uint b_mantissa = uint(b_bits) & 1023u;
    if (a_field != 0u) a_mantissa += 1024u;
    if (b_field != 0u) b_mantissa += 1024u;
    const int a_exponent = a_field == 0u ? -14 : int(a_field) - 15;
    const int b_exponent = b_field == 0u ? -14 : int(b_field) - 15;
    product_significands[inner] = a_mantissa * b_mantissa * 8u;
    product_exponents[inner] = a_exponent + b_exponent;
    product_negative[inner] = ((a_bits ^ b_bits) & 0x8000u) != 0u;
    if (product_significands[inner] != 0u)
      maximum_exponent = max(maximum_exponent, product_exponents[inner]);
  }

  const ushort c_bits = as_type<ushort>(prior);
  const uint c_field = (uint(c_bits) >> 10u) & 31u;
  const uint c_fraction = uint(c_bits) & 1023u;
  uint c_significand = 0u;
  int c_exponent = -1024;
  if (c_field != 0u) {
    c_significand = (1024u + c_fraction) << 13u;
    c_exponent = int(c_field) - 15;
  } else if (c_fraction != 0u) {
    const uint leading = 31u - clz(c_fraction);
    c_significand = c_fraction << (23u - leading);
    c_exponent = int(leading) - 24;
  }
  if (c_significand != 0u)
    maximum_exponent = max(maximum_exponent, c_exponent);

  uint positive = 0u;
  uint negative = 0u;
  for (uint inner = 0u; inner < 16u; ++inner) {
    const int shift = maximum_exponent - product_exponents[inner];
    const uint aligned = shift > 31
        ? 0u : (product_significands[inner] << 2u) >> uint(shift);
    if (product_negative[inner]) negative += aligned;
    else positive += aligned;
  }
  if (c_significand != 0u) {
    const int shift = maximum_exponent - c_exponent;
    const uint aligned = shift > 31
        ? 0u : (c_significand << 2u) >> uint(shift);
    if ((c_bits & 0x8000u) != 0u) negative += aligned;
    else positive += aligned;
  }
  const bool result_negative = negative > positive;
  const uint magnitude = result_negative ? negative - positive
                                         : positive - negative;
  return fg_fixed_u32_to_half_rne(
      magnitude, result_negative, maximum_exponent - 25);
}
