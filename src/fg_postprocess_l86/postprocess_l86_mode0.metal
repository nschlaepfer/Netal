// Exact mode-0 reconstruction of selected FG launch 86 / module 19.
//
// The control/data schedule was imported from the pinned SM120 PTX through
// CuMetal, then specialized to the live mode-0 ABI. The module's constant
// bfind.shiftamt.u32(0x20000000) was folded to 2 only after a live SM120
// instruction receipt. The unreachable mode-1 texture/surface path remains in
// this generated body for auditability but v5 is a compile-time zero and the
// host rejects every nonzero mode before encoding work. NVIDIA
// div.approx.ftz.f32 is recovered with the independently measured SM120 RCP
// correction ROM below; ordinary division is retained only as an explicit
// negative-control build.
//
// The large SSA-shaped body is deliberate: it preserves the selected warp,
// shared-memory, FMA and conversion order while the clean high-level pull-push
// formulation remains a later refactor guarded by this byte-exact receipt.

#include <metal_stdlib>
using namespace metal;


struct CmTexture2DDescriptor {
    ulong data;
    uint width;
    uint height;
    uint format;
    uint channels;
};

static inline float cm_texture_component(
    device const CmTexture2DDescriptor* descriptor,
    int x, int y, uint component) {
    if (component >= descriptor->channels) return 0.0f;
    x = clamp(x, 0, int(descriptor->width) - 1);
    y = clamp(y, 0, int(descriptor->height) - 1);
    ulong element = (ulong(y) * ulong(descriptor->width) + ulong(x)) *
                    ulong(descriptor->channels) + ulong(component);
    device const uchar* data =
        reinterpret_cast<device const uchar*>(descriptor->data);
    if (descriptor->format == 16u) {
        return float(*reinterpret_cast<device const half*>(data + element * 2ul));
    }
    return *reinterpret_cast<device const float*>(data + element * 4ul);
}

static inline float4 cm_texture_texel(
    device const CmTexture2DDescriptor* descriptor, int x, int y) {
    return float4(cm_texture_component(descriptor, x, y, 0u),
                  cm_texture_component(descriptor, x, y, 1u),
                  cm_texture_component(descriptor, x, y, 2u),
                  cm_texture_component(descriptor, x, y, 3u));
}

static inline float4 cm_tex_base_2d_s32(ulong handle, int x, int y) {
    device const CmTexture2DDescriptor* descriptor =
        reinterpret_cast<device const CmTexture2DDescriptor*>(handle);
    return cm_texture_texel(descriptor, x, y);
}

static inline float4 cm_tex_level_2d_f32(
    ulong handle, float u, float v, float level) {
    (void)level;
    device const CmTexture2DDescriptor* descriptor =
        reinterpret_cast<device const CmTexture2DDescriptor*>(handle);
    float x = rint((u * float(descriptor->width) - 0.5f) * 256.0f) /
              256.0f;
    float y = rint((v * float(descriptor->height) - 0.5f) * 256.0f) /
              256.0f;
    int x0 = int(floor(x));
    int y0 = int(floor(y));
    float tx = x - float(x0);
    float ty = y - float(y0);
    float4 row0 = mix(cm_texture_texel(descriptor, x0, y0),
                      cm_texture_texel(descriptor, x0 + 1, y0), tx);
    float4 row1 = mix(cm_texture_texel(descriptor, x0, y0 + 1),
                      cm_texture_texel(descriptor, x0 + 1, y0 + 1), tx);
    return mix(row0, row1, ty);
}

static inline float4 cm_tld4_r_2d_f32(ulong handle, float u, float v) {
    device const CmTexture2DDescriptor* descriptor =
        reinterpret_cast<device const CmTexture2DDescriptor*>(handle);
    float x = rint((u * float(descriptor->width) - 0.5f) * 256.0f) /
              256.0f;
    float y = rint((v * float(descriptor->height) - 0.5f) * 256.0f) /
              256.0f;
    int x0 = int(floor(x));
    int y0 = int(floor(y));
    return float4(cm_texture_component(descriptor, x0, y0, 0u),
                  cm_texture_component(descriptor, x0 + 1, y0, 0u),
                  cm_texture_component(descriptor, x0, y0 + 1, 0u),
                  cm_texture_component(descriptor, x0 + 1, y0 + 1, 0u));
}

static inline void cm_sust_b_2d_b32_zero(
    ulong handle, int byte_x, int y, uint value) {
    device const CmTexture2DDescriptor* descriptor =
        reinterpret_cast<device const CmTexture2DDescriptor*>(handle);
    uint component_bytes = descriptor->format == 16u ? 2u : 4u;
    ulong row_bytes = ulong(descriptor->width) *
                      ulong(descriptor->channels) * ulong(component_bytes);
    if (byte_x < 0 || y < 0 || uint(y) >= descriptor->height ||
        ulong(byte_x) + 4ul > row_bytes) return;
    device uchar* data = reinterpret_cast<device uchar*>(descriptor->data);
    *reinterpret_cast<device uint*>(data + ulong(y) * row_bytes +
                                    ulong(byte_x)) = value;
}

static inline ushort cm_float_to_half_rz_bits(float value) {
    uint bits = as_type<uint>(value);
    ushort sign = ushort((bits >> 16u) & 0x8000u);
    uint exponent = (bits >> 23u) & 0xffu;
    uint mantissa = bits & 0x7fffffu;
    if (exponent == 0xffu) {
        return ushort(sign | (mantissa == 0u ? 0x7c00u : 0x7e00u));
    }
    int half_exponent = int(exponent) - 127 + 15;
    if (half_exponent >= 31) return ushort(sign | 0x7c00u);
    if (half_exponent <= 0) {
        if (half_exponent < -10) return sign;
        uint significand = mantissa | 0x800000u;
        uint shift = uint(14 - half_exponent);
        return ushort(sign | ushort(significand >> shift));
    }
    return ushort(sign | ushort(uint(half_exponent) << 10u) |
                  ushort(mantissa >> 13u));
}

static inline void cm_sust_p_2d_v4_b32_zero(
    ulong handle, int x, int y, float a, float b, float c, float d) {
    device const CmTexture2DDescriptor* descriptor =
        reinterpret_cast<device const CmTexture2DDescriptor*>(handle);
    if (x < 0 || y < 0 || uint(x) >= descriptor->width ||
        uint(y) >= descriptor->height) return;
    float4 values = float4(a, b, c, d);
    ulong base = (ulong(y) * ulong(descriptor->width) + ulong(x)) *
                 ulong(descriptor->channels);
    device uchar* data = reinterpret_cast<device uchar*>(descriptor->data);
    for (uint component = 0u; component < min(descriptor->channels, 4u);
         ++component) {
        if (descriptor->format == 16u) {
            *reinterpret_cast<device ushort*>(data +
                (base + ulong(component)) * 2ul) =
                    cm_float_to_half_rz_bits(values[component]);
        } else {
            *reinterpret_cast<device float*>(data +
                (base + ulong(component)) * 4ul) = values[component];
        }
    }
}


static inline float cm_ex2_approx_ftz_f32(float value) {
    return fast::exp2(value);
}
static inline float cm_lg2_approx_ftz_f32(float value) {
    return fast::log2(value);
}
static inline float cm_rne_rcp_f32(float value) {
    float candidate = 1.0f / value;
    uint bits = as_type<uint>(candidate);
    float below = as_type<float>(bits - 1u);
    float above = as_type<float>(bits + 1u);
    float residual_candidate = fabs(fma(-value, candidate, 1.0f));
    float residual_below = fabs(fma(-value, below, 1.0f));
    float residual_above = fabs(fma(-value, above, 1.0f));
    float best = candidate;
    float best_residual = residual_candidate;
    if (residual_below < best_residual || (residual_below == best_residual && ((bits - 1u) & 1u) == 0u)) { best = below; best_residual = residual_below; }
    if (residual_above < best_residual || (residual_above == best_residual && ((bits + 1u) & 1u) == 0u)) { best = above; }
    return best;
}
static inline float cm_rcp_approx_ftz_f32(float value, device const uchar* correction_rom) {
    uint input_bits = as_type<uint>(value);
    uint base_bits = as_type<uint>(cm_rne_rcp_f32(value));
    uint exponent = (input_bits >> 23u) & 0xffu;
    uint output_exponent = (base_bits >> 23u) & 0xffu;
    if ((input_bits >> 31u) != 0u || exponent == 0u || exponent == 0xffu || output_exponent == 0u || output_exponent == 0xffu) return as_type<float>(base_bits);
    uint mantissa = input_bits & 0x7fffffu;
    uchar packed = correction_rom[mantissa >> 2u];
    uint code = (uint(packed) >> ((mantissa & 3u) * 2u)) & 3u;
    if (code == 1u) base_bits -= 1u; else if (code == 2u) base_bits += 1u;
    return as_type<float>(base_bits);
}
static inline float cm_div_approx_ftz_f32(float numerator, float denominator, device const uchar* correction_rom) {
#if defined(FG_L86_NEGATIVE_PRECISE_DIVISION)
    (void)correction_rom;
    return numerator / denominator;
#else
    return numerator * cm_rcp_approx_ftz_f32(denominator, correction_rom);
#endif
}
static inline uint cm_pack_f16x2_f32(float a, float b) { return as_type<uint>(half2(half(b), half(a))); }

