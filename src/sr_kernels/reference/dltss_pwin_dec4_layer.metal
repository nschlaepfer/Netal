    // int(float) truncates toward zero, magnitude < 2^27.
    float scale = as_type<float>(uint(25 - maximum_exponent + 127) << 23u);
    int total = 0;
    for (uint inner = 0u; inner < 16u; ++inner) {
        total += int(products[inner] * scale);
