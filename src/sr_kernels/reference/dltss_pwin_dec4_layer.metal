// True when every real number within U of v rounds (RNE, binary16) to h.
static inline bool __cm_wmma_interval_pass(float v, half h, float U) {
    if (!isfinite(v)) return false;
    uint h_bits = uint(as_type<ushort>(h));
    uint field = (h_bits >> 10u) & 31u;
    uint mantissa = h_bits & 1023u;
    if (field == 31u) return false;
    float ulp = as_type<float>(uint(int(max(field, 1u)) - 15 - 10 + 127) << 23u);
    float hf = float(h);
    bool power_of_two = mantissa == 0u && field != 0u;
    float toward_zero_gap = power_of_two ? ulp * 0.25f : ulp * 0.5f;
    float away_gap = ulp * 0.5f;
    float low = hf >= 0.0f ? hf - toward_zero_gap : hf - away_gap;
    float high = hf >= 0.0f ? hf + away_gap : hf + toward_zero_gap;
    float margin = U + fabs(v) * 0x1p-22f;
    return (v - margin > low) && (v + margin < high);
}

static inline half __cm_wmma_checked_value(
