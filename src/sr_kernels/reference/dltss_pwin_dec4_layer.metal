    uint source_lane1 = (row0 + 1u) * 4u + (column >> 1u);
    uint source0 = simd_shuffle(source, ushort(source_lane0));
    uint source1 = simd_shuffle(source, ushort(source_lane1));
    uint shift = (column & 1u) << 4u;
    return ((source0 >> shift) & 0xffffu) |
           (((source1 >> shift) & 0xffffu) << 16u);
