    ulong remainder = value & ((1ul << shift) - 1ul);
    ulong halfway = 1ul << (shift - 1u);
    if (remainder > halfway ||
        (remainder == halfway && (quotient & 1ul) != 0ul)) {
        ++quotient;
    }
    return quotient;
