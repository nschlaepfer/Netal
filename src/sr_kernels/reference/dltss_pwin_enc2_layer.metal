    float toward_zero_gap = power_of_two ? ulp * 0.25f : ulp * 0.5f;
    float away_gap = ulp * 0.5f;
    float low = hf >= 0.0f ? hf - toward_zero_gap : hf - away_gap;
    float high = hf >= 0.0f ? hf + away_gap : hf + toward_zero_gap;
    float margin = U + fabs(v) * 0x1p-22f;
    return (v - margin > low) && (v + margin < high);
