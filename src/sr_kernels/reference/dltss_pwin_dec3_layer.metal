    uint field = (h_bits >> 10u) & 31u;
    uint mantissa = h_bits & 1023u;
    if (field == 31u) return false;
    float ulp = as_type<float>(uint(int(max(field, 1u)) - 15 - 10 + 127) << 23u);
    float hf = float(h);
