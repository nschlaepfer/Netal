    ulong handle, int x, int y, float a, float b, float c, float d) {
    device const CmTexture2DDescriptor* descriptor =
        reinterpret_cast<device const CmTexture2DDescriptor*>(handle);
    if (x < 0 || y < 0 || uint(x) >= descriptor->width ||
        uint(y) >= descriptor->height) return;
    float4 values = float4(a, b, c, d);
    ulong base = (ulong(y) * ulong(descriptor->width) + ulong(x)) *
                 ulong(descriptor->channels);
    device uchar* data = reinterpret_cast<device uchar*>(descriptor->data);
    for (uint component = 0u; component < min(descriptor->channels, 4u);
