static inline void cm_record_mufu_miss(
    device atomic_uint* table, uint key) {
    uint slot = (key * 0x9e3779b9u) & 0xfffffu;
    for (uint probe = 0; probe < 32u; ++probe) {
        uint expected = 0u;
        if (atomic_compare_exchange_weak_explicit(
                &table[slot], &expected, key,
                memory_order_relaxed, memory_order_relaxed) || expected == key) return;
        slot = (slot + 1u) & 0xfffffu;
    }
}
static inline float cm_mufu_contract(
    float value, device const uint* keys, device const uint* values,
    device atomic_uint* misses, bool lg2) {
    uint key = as_type<uint>(value);
    if (key == 0u) key = 1u;
    uint slot = (key * 0x9e3779b9u) & 0xfffffu;
    for (uint probe = 0; probe < 32u; ++probe) {
        uint found = keys[slot];
        if (found == key) return as_type<float>(values[slot]);
        if (found == 0u) break;
        slot = (slot + 1u) & 0xfffffu;
    }
    cm_record_mufu_miss(misses, key);
    return lg2 ? fast::log2(value) : fast::exp2(value);
}
