    uint output_exponent = (base_bits >> 23u) & 0xffu;
    if ((input_bits >> 31u) != 0u || exponent == 0u || exponent == 0xffu ||
        output_exponent == 0u || output_exponent == 0xffu) {
        return as_type<float>(base_bits);
