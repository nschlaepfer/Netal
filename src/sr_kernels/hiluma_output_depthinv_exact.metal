struct CmTexture2DDescriptor {
    ulong data;
    uint width;
    uint height;
    uint format;
    uint channels;
};

static inline float cm_texture_component(
    device const CmTexture2DDescriptor* descriptor,
    int x, int y, uint component) {
    if (component >= descriptor->channels) return 0.0f;
    x = clamp(x, 0, int(descriptor->width) - 1);
    y = clamp(y, 0, int(descriptor->height) - 1);
    ulong element = (ulong(y) * ulong(descriptor->width) + ulong(x)) *
                    ulong(descriptor->channels) + ulong(component);
    device const uchar* data =
        reinterpret_cast<device const uchar*>(descriptor->data);
    if (descriptor->format == 16u) {
        return float(*reinterpret_cast<device const half*>(data + element * 2ul));
    }
    return *reinterpret_cast<device const float*>(data + element * 4ul);
}

static inline float4 cm_texture_texel(
    device const CmTexture2DDescriptor* descriptor, int x, int y) {
    // One clamp, one address and one format decision for the whole texel.
    //
    // The transpiler emits this per component, so a four-channel fetch paid four bounds checks,
    // four 64-bit address computations and four format branches to read four adjacent values.
    // Components are contiguous by construction - element = (y*w + x)*channels + component - so the
    // base is shared and, at four channels, the four values are one packed load. packed_* because
    // the descriptor points into an arena at an offset this code does not control, so the vector
    // load must not assume vector alignment.
    //
    // The arithmetic is untouched: same clamp, same half-to-float widening, same zero for channels
    // the texture does not have. Verified against the four RTX receipts, and worth 0.2 ms of a
    // 6.8 ms frame at 1080p.
    const uint width = descriptor->width;
    const uint channels = descriptor->channels;
    const uint cx = uint(clamp(x, 0, int(width) - 1));
    const uint cy = uint(clamp(y, 0, int(descriptor->height) - 1));
    const uint base = (cy * width + cx) * channels;
    device const uchar* data = reinterpret_cast<device const uchar*>(descriptor->data);
    if (descriptor->format == 16u) {
        device const half* p = reinterpret_cast<device const half*>(data + ulong(base) * 2ul);
        if (channels == 4u) return float4(*reinterpret_cast<device const packed_half4*>(p));
        float4 o = float4(0.0f);
        if (channels > 0u) o.x = float(p[0]);
        if (channels > 1u) o.y = float(p[1]);
        if (channels > 2u) o.z = float(p[2]);
        return o;
    }
    device const float* p = reinterpret_cast<device const float*>(data + ulong(base) * 4ul);
    if (channels == 4u) return float4(*reinterpret_cast<device const packed_float4*>(p));
    float4 o = float4(0.0f);
    if (channels > 0u) o.x = p[0];
    if (channels > 1u) o.y = p[1];
    if (channels > 2u) o.z = p[2];
    return o;
}

