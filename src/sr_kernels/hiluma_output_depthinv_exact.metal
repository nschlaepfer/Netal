    // Verified against the RTX 5090 f32 register trace of launch 27
    // (frame 1): CuMetal's emulation returned the same texels row-major.
    // Four texels, one component, one set of descriptor reads. Per-component this paid four
    // channel checks, eight clamps, four 64-bit address computations and four format branches to
    // read four values; the gather only needs two clamped columns, two clamped rows and one format
    // decision. Order and values are unchanged - the tld4 order above is load-bearing.
    const uint width = descriptor->width;
    const uint height = descriptor->height;
    const uint channels = descriptor->channels;
    if (channels == 0u) return float4(0.0f);
    const uint cx0 = uint(clamp(x0, 0, int(width) - 1));
    const uint cx1 = uint(clamp(x0 + 1, 0, int(width) - 1));
    const uint cy0 = uint(clamp(y0, 0, int(height) - 1));
    const uint cy1 = uint(clamp(y0 + 1, 0, int(height) - 1));
    const uint r0 = cy0 * width, r1 = cy1 * width;
    device const uchar* data = reinterpret_cast<device const uchar*>(descriptor->data);
    if (descriptor->format == 16u) {
        device const half* h = reinterpret_cast<device const half*>(data);
        return float4(float(h[(r1 + cx0) * channels]), float(h[(r1 + cx1) * channels]),
                      float(h[(r0 + cx1) * channels]), float(h[(r0 + cx0) * channels]));
    }
    device const float* f = reinterpret_cast<device const float*>(data);
    return float4(f[(r1 + cx0) * channels], f[(r1 + cx1) * channels],
                  f[(r0 + cx1) * channels], f[(r0 + cx0) * channels]);
}

static inline void cm_sust_b_2d_b32_zero(
    ulong handle, int byte_x, int y, uint value) {
    device const CmTexture2DDescriptor* descriptor =
        reinterpret_cast<device const CmTexture2DDescriptor*>(handle);
    uint component_bytes = descriptor->format == 16u ? 2u : 4u;
    ulong row_bytes = ulong(descriptor->width) *
                      ulong(descriptor->channels) * ulong(component_bytes);
    if (byte_x < 0 || y < 0 || uint(y) >= descriptor->height ||
        ulong(byte_x) + 4ul > row_bytes) return;
    device uchar* data = reinterpret_cast<device uchar*>(descriptor->data);
    *reinterpret_cast<device uint*>(data + ulong(y) * row_bytes +
                                    ulong(byte_x)) = value;
}

static inline ushort cm_float_to_half_rz_bits(float value) {
    uint bits = as_type<uint>(value);
