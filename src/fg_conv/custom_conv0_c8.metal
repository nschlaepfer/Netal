#include <metal_stdlib>
#include "hmma_exact.metalh"
using namespace metal;
inline uint c0_weight_index(uint tile,uint stage,uint ic,uint oc){uint group=oc/8u,n=oc%8u,k=ic%16u,lane=n*4u+(k%8u)/2u,frag=(k>=8u?2u:0u)+(k&1u);return group*2304u+tile*256u+stage*128u+(frag>=2u?64u:0u)+lane*2u+(frag&1u);}
inline half c0_value(device const half*w,device const half*b,device const half*in,uint x,uint y,uint oc){half a=b[oc];for(uint tile=0;tile<9;++tile){int ix=int(x)+int(tile%3u)-1,iy=int(y)+int(tile/3u)-1;bool ok=ix>=0&&ix<320&&iy>=0&&iy<184;uint base=ok?(uint(iy)*320u+uint(ix))*32u:0u;for(uint stage=0;stage<2;++stage){ushort av[16],bv[16];for(uint k=0;k<16;++k){uint ic=stage*16u+k;av[k]=ok?as_type<ushort>(in[base+ic]):ushort(0);bv[k]=as_type<ushort>(w[c0_weight_index(tile,stage,ic,oc)]);}a=fg_hmma_f16_bits_16(av,bv,a);}}half slope=half(0.01f);return min(max(max(a,half(a*slope)),half(-6.0f)),half(6.0f));}
kernel void fg_custom_block0_conv0_c8(device const half*w[[buffer(0)]],device const half*b[[buffer(1)]],device const half*in[[buffer(2)]],device half*out[[buffer(3)]],uint3 gid[[thread_position_in_grid]]){if(gid.x>=160||gid.y>=92||gid.z>=32)return;uint x=gid.x*2u,y=gid.y*2u,oc=gid.z;half v00=c0_value(w,b,in,x,y,oc),v01=c0_value(w,b,in,x+1,y,oc),v10=c0_value(w,b,in,x,y+1,oc),v11=c0_value(w,b,in,x+1,y+1,oc);half p=half(v00+v01);p=half(p+v10);p=half(p+v11);p=half(p*half(0.25f));out[(gid.y*160u+gid.x)*32u+oc]=p;}
