inline half up(device const half*in,int x,int y,uint c){if(x<0||x>=160||y<0||y>=92)return half(0);float fx=(float(x)-0.5f)*0.5f,fy=(float(y)-0.5f)*0.5f;uint x0=fx<0.0f?0u:min(uint(fx),79u),x1=fx<0.0f?0u:min(uint(fx+1.0f),79u),y0=fy<0.0f?0u:min(uint(fy),45u),y1=fy<0.0f?0u:min(uint(fy+1.0f),45u);half wx1=half(fx-float(x0)),wx0=half(1.0f-(fx-float(x0))),wy1=half(fy-float(y0)),wy0=half(1.0f-(fy-float(y0)));half a=in[(y0*80u+x0)*64u+c],b=in[(y0*80u+x1)*64u+c],d=in[(y1*80u+x0)*64u+c],e=in[(y1*80u+x1)*64u+c];half top=half(half(wx0*a)+half(wx1*b));top=half(wy0*top);half bot=half(half(wx0*d)+half(wx1*e));bot=half(wy1*bot);return half(top+bot);}
inline uint wi(uint t,uint s,uint ic,uint oc){uint g=oc/8u,n=oc%8u,k=ic%16u,lane=n*4u+(k%8u)/2u,f=(k>=8u?2u:0u)+(k&1u);return g*4608u+t*512u+s*128u+(f>=2u?64u:0u)+lane*2u+(f&1u);}
kernel void fg_custom_block0_bot0(device const half*w[[buffer(0)]],device const half*b[[buffer(1)]],device const half*in[[buffer(2)]],device half*o0[[buffer(3)]],device half*o1[[buffer(4)]],device half*o2[[buffer(5)]],uint3 g[[thread_position_in_grid]]){if(g.x>=160||g.y>=92||g.z>=96)return;uint oc=g.z;half a=b[oc];for(uint t=0;t<9;++t){int x=int(g.x)+int(t%3u)-1,y=int(g.y)+int(t/3u)-1;for(uint s=0;s<4;++s){ushort av[16],bv[16];for(uint k=0;k<16;++k){uint ic=s*16u+k;av[k]=as_type<ushort>(up(in,x,y,ic));bv[k]=as_type<ushort>(w[wi(t,s,ic,oc)]);}a=fg_hmma_f16_bits_16(av,bv,a);}}half q=half(0.01f);a=max(a,half(a*q));uint branch=oc/32u,lc=oc%32u;if(branch!=0u)a=min(max(a,half(-6.0f)),half(6.0f));uint i=(g.y*160u+g.x)*32u+lc;if(branch==0)o0[i]=a;else if(branch==1)o1[i]=a;else o2[i]=a;}
