inline half fg_b1_bot1_up(device const half*in,int x,int y,uint c){if(x<0||x>=640||y<0||y>=368)return half(0);float fx=(float(x)-0.5f)*0.5f,fy=(float(y)-0.5f)*0.5f;uint x0=fx<0?0u:min(uint(fx),319u),x1=fx<0?0u:min(uint(fx+1.0f),319u),y0=fy<0?0u:min(uint(fy),183u),y1=fy<0?0u:min(uint(fy+1.0f),183u);half wx1=half(fx-float(x0)),wx0=half(1.0f-(fx-float(x0))),wy1=half(fy-float(y0)),wy0=half(1.0f-(fy-float(y0)));half a=in[(y0*320u+x0)*16u+c],b=in[(y0*320u+x1)*16u+c],d=in[(y1*320u+x0)*16u+c],e=in[(y1*320u+x1)*16u+c];half top=half(half(wx0*a)+half(wx1*b));top=half(wy0*top);half bot=half(half(wx0*d)+half(wx1*e));bot=half(wy1*bot);return half(top+bot);}
